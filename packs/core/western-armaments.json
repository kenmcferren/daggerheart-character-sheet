              "tiers": {
                "1": {
                  "damage": "d6+2"
                },
                "2": {
                  "damage": "d6+5"
                },
                "3": {
                  "damage": "d6+8"
                },
                "4": {
                  "damage": "d6+11"
                }
              }
            },
            {
