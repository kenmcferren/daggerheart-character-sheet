              "weaponSlot": "primary",
              "trait": "finesse",
              "range": "far",
              "burden": "one-handed",
              "feature": "Six Shot: Place 6 Ammo tokens on your character sheet. Spend 1 Ammo token to make an attack. You can mark a Stress to regain spent Ammo tokens.",
              "damageType": "physical",
              "tiers": {
                "1": {
                  "damage": "d8+1"
                },
                "2": {
                  "damage": "d8+4"
                },
                "3": {
                  "damage": "d8+7"
                },
                "4": {
                  "damage": "d8+10"
                }
              }
            },
            {
