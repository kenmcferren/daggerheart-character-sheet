              "name": "Rifle",
              "weaponSlot": "primary",
              "trait": "agility",
              "range": "very-far",
              "burden": "two-handed",
              "feature": "Sightline: Spend 2 Hope to gain advantage on an attack roll.",
              "damageType": "physical",
              "tiers": {
                "1": {
                  "damage": "d8+2"
                },
                "2": {
                  "damage": "d8+5"
                },
                "3": {
                  "damage": "d8+8"
                },
                "4": {
                  "damage": "d8+11"
                }
              }
