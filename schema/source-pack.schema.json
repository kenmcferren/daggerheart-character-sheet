{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source-pack.schema.json",
  "title": "Source pack",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "publisher"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "extends": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": { "$ref": "#/definitions/entries" },
        "subclasses": { "$ref": "#/definitions/entries" },
        "ancestries": { "$ref": "#/definitions/entries" },
        "communities": { "$ref": "#/definitions/entries" },
        "domains": { "$ref": "#/definitions/entries" },
        "domainCards": { "$ref": "#/definitions/entries" },
        "equipment": { "$ref": "#/definitions/entries" },
        "campaignFrames": { "$ref": "#/definitions/entries" },
        "levelUpOptions": { "$ref": "#/definitions/entries" }
      }
    },
    "overrides": {
      "description": "Per content kind: entry id -> fields shallow-merged onto the existing entry.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": { "$ref": "#/definitions/patches" },
        "subclasses": { "$ref": "#/definitions/patches" },
        "ancestries": { "$ref": "#/definitions/patches" },
        "communities": { "$ref": "#/definitions/patches" },
        "domains": { "$ref": "#/definitions/patches" },
        "domainCards": { "$ref": "#/definitions/patches" },
        "equipment": { "$ref": "#/definitions/patches" },
        "campaignFrames": { "$ref": "#/definitions/patches" },
        "levelUpOptions": { "$ref": "#/definitions/patches" }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "entry": {
      "description": "Kind-specific fields are added per kind once the SRD shape is known (Series 2).",
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "patches": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]*$" },
      "additionalProperties": { "type": "object", "not": { "required": ["id"] } }
    }
  }
}
