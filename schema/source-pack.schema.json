{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source-pack.schema.json",
  "title": "Source pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      },
      "uniqueItems": true
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/class"
          }
        },
        "subclasses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subclass"
          }
        },
        "ancestries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ancestry"
          }
        },
        "communities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/community"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/domain"
          }
        },
        "domainCards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/domainCard"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/equipmentItem"
          }
        },
        "campaignFrames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/campaignFrame"
          }
        },
        "levelUpOptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/levelUpOption"
          }
        }
      }
    },
    "overrides": {
      "description": "Per content kind: entry id -> fields shallow-merged onto the existing entry.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "$ref": "#/definitions/patches"
        },
        "subclasses": {
          "$ref": "#/definitions/patches"
        },
        "ancestries": {
          "$ref": "#/definitions/patches"
        },
        "communities": {
          "$ref": "#/definitions/patches"
        },
        "domains": {
          "$ref": "#/definitions/patches"
        },
        "domainCards": {
          "$ref": "#/definitions/patches"
        },
        "equipment": {
          "$ref": "#/definitions/patches"
        },
        "campaignFrames": {
          "$ref": "#/definitions/patches"
        },
        "levelUpOptions": {
          "$ref": "#/definitions/patches"
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "entry": {
      "description": "Base entry. Kind definitions add typed fields; unknown extra fields are allowed so third-party packs can carry their own data. Rules fields hold SRD rules text only (no flavor).",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    "patches": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "not": {
          "required": [
            "id"
          ]
        }
      }
    },
    "count": {
      "description": "Fixed number, derived from a trait modifier, equal to the character level, or Tier plus a base and/or trait (used for circles/boxes printed with rule text).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "trait"
          ],
          "additionalProperties": false,
          "properties": {
            "trait": {
              "enum": [
                "agility",
                "strength",
                "finesse",
                "instinct",
                "presence",
                "knowledge",
                "spellcast"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tier"
          ],
          "additionalProperties": false,
          "properties": {
            "tier": {
              "const": true
            },
            "base": {
              "type": "integer"
            },
            "trait": {
              "enum": [
                "agility",
                "strength",
                "finesse",
                "instinct",
                "presence",
                "knowledge",
                "spellcast"
              ]
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "foundation",
            "specialization",
            "mastery"
          ]
        },
        "uses": {
          "$ref": "#/definitions/count"
        },
        "usesPer": {
          "enum": [
            "short-rest",
            "long-rest",
            "rest",
            "scene",
            "session"
          ]
        },
        "short": {
          "type": "string",
          "description": "Condensed wording for the printed sheet; \"\" = print nothing (folded into the previous feature)."
        },
        "sheetCards": {
          "type": "object",
          "required": [
            "label",
            "items"
          ],
          "description": "Items printed as their own blocks on the domain card sheet (e.g. poisons).",
          "properties": {
            "label": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "short"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "short": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "sheetTable": {
          "type": "object",
          "required": [
            "title",
            "rows"
          ],
          "description": "One column of a table printed across the top of the domain card sheet; the row names are shared by the subclass features.",
          "properties": {
            "title": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "short"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "short": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "trackers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tracker"
          }
        },
        "statNote": {
          "$ref": "#/definitions/statNote"
        },
        "experienceStart": {
          "type": "integer",
          "description": "Starting bonus for new Experiences (Android: 3 instead of 2)."
        },
        "extraSecondaryWeapon": {
          "type": "boolean",
          "description": "The character may wield one more secondary weapon (Kasatha)."
        },
        "weapon": {
          "type": "object",
          "required": [
            "name",
            "traits",
            "range",
            "damage",
            "damageType"
          ],
          "description": "A natural weapon granted by the feature (claws, bite); printed as a weapon line using the character Proficiency.",
          "properties": {
            "name": {
              "type": "string"
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "range": {
              "type": "string"
            },
            "damage": {
              "type": "string"
            },
            "damageType": {
              "enum": [
                "physical",
                "magic"
              ]
            }
          }
        },
        "countBox": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "description": "A write-in count box with no upper limit, printed on the inventory header row (Scrapborn Junk Count).",
          "properties": {
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/feature"
      }
    },
    "tracker": {
      "description": "Printed marks only, never stored. box = HP/Armor/Stress/frame counters; circle = uses tied to a trait.",
      "type": "object",
      "required": [
        "id",
        "shape",
        "count",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "shape": {
          "enum": [
            "box",
            "circle"
          ]
        },
        "count": {
          "$ref": "#/definitions/count"
        },
        "label": {
          "type": "string"
        },
        "placement": {
          "enum": [
            "front",
            "back"
          ]
        },
        "attachTo": {
          "type": "string"
        },
        "perTier": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statNote": {
      "description": "Flags a headline stat this feature/card/item can change, that the printed sheet does not (and, for 'situational', cannot) bake into the number: a footnote symbol goes on the stat's label and on this entry's name, with `text` in the page's legend. 'build' = depends on the character's own gear/loadout, knowable from the sheet but not modelled (e.g. an Armor Score bonus while wearing armor); 'situational' = depends on what happens at the table (e.g. an Evasion bonus against one kind of attack).",
      "type": "object",
      "required": [
        "kind",
        "stats",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "build",
            "situational"
          ]
        },
        "stats": {
          "type": "array",
          "items": {
            "enum": [
              "evasion",
              "majorThreshold",
              "severeThreshold",
              "armorScore",
              "proficiency"
            ]
          },
          "minItems": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "choice": {
      "description": "A choice the wizard asks the player.",
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "pick",
            "text",
            "roll-table",
            "builder",
            "pick-one-each-from"
          ]
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "pool": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "free": {
                "type": "boolean"
              }
            }
          }
        },
        "fixed": {
          "type": "object"
        }
      }
    },
    "frameOp": {
      "description": "One ordered operation a campaign frame applies to character creation. Per-op fields are validated when frame packs are built (step 3).",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "replace-pool",
            "add-to-pool",
            "insert-step",
            "set-resource",
            "grant",
            "annotate",
            "remove-move",
            "add-move",
            "add-tracker",
            "add-levelup-option",
            "back-sheet",
            "list-ancestries-first",
            "hide-ancestries",
            "disable-mixed-ancestry",
            "list-communities-first",
            "starting-stims",
            "consumables"
          ]
        }
      }
    },
    "class": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "startingEvasion": {
              "type": "integer"
            },
            "startingHitPoints": {
              "type": "integer"
            },
            "classItems": {
              "type": "string"
            },
            "hopeFeature": {
              "$ref": "#/definitions/feature"
            },
            "features": {
              "$ref": "#/definitions/features"
            },
            "subclasses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              }
            },
            "backgroundQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "supplements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "rules"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "rules": {
                    "type": "string"
                  }
                }
              }
            },
            "beastforms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "tier",
                  "features"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/definitions/id"
                  },
                  "name": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "examples": {
                    "type": "string"
                  },
                  "traitBonus": {
                    "type": "object",
                    "required": [
                      "trait",
                      "bonus"
                    ],
                    "properties": {
                      "trait": {
                        "enum": [
                          "agility",
                          "strength",
                          "finesse",
                          "instinct",
                          "presence",
                          "knowledge"
                        ]
                      },
                      "bonus": {
                        "type": "integer"
                      }
                    }
                  },
                  "evasionBonus": {
                    "type": "integer"
                  },
                  "thresholdBonus": {
                    "type": "integer"
                  },
                  "attack": {
                    "type": "object",
                    "required": [
                      "range",
                      "trait",
                      "damage",
                      "damageType"
                    ],
                    "properties": {
                      "range": {
                        "enum": [
                          "melee",
                          "very-close",
                          "close",
                          "far",
                          "very-far"
                        ]
                      },
                      "trait": {
                        "enum": [
                          "agility",
                          "strength",
                          "finesse",
                          "instinct",
                          "presence",
                          "knowledge"
                        ]
                      },
                      "damage": {
                        "type": "string"
                      },
                      "damageType": {
                        "enum": [
                          "physical",
                          "magic"
                        ]
                      }
                    }
                  },
                  "advantages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "rules"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "rules": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "companion": {
              "type": "object",
              "required": [
                "startingEvasion",
                "experiences",
                "levelUpOptions"
              ],
              "properties": {
                "startingEvasion": {
                  "type": "integer"
                },
                "experiences": {
                  "type": "object",
                  "required": [
                    "count",
                    "bonus"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "bonus": {
                      "type": "integer"
                    }
                  }
                },
                "startingDamageDie": {
                  "type": "string"
                },
                "startingRange": {
                  "enum": [
                    "melee",
                    "very-close",
                    "close",
                    "far",
                    "very-far"
                  ]
                },
                "damageTypes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "physical",
                      "magic"
                    ]
                  }
                },
                "exampleExperiences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "levelUpOptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "rules"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/id"
                      },
                      "name": {
                        "type": "string"
                      },
                      "rules": {
                        "type": "string"
                      },
                      "short": {
                        "type": "string",
                        "description": "Condensed wording for the printed sheet; \"\" = print nothing (folded into the previous feature)."
                      }
                    }
                  }
                }
              }
            },
            "stances": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "tier",
                  "rules"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/definitions/id"
                  },
                  "name": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "rules": {
                    "type": "string"
                  },
                  "short": {
                    "type": "string",
                    "description": "Condensed wording for the printed sheet; \"\" = print nothing (folded into the previous feature)."
                  }
                }
              }
            },
            "focusMax": {
              "type": "integer"
            },
            "knownStancesAtCreation": {
              "type": "integer"
            },
            "onlyWith": {
              "type": "string",
              "description": "Id of the campaign frame or supplement that must be selected for this class to be offered."
            },
            "startingDomainCards": {
              "type": "integer",
              "minimum": 1,
              "description": "Level 1 domain cards at creation (default 2)."
            },
            "allowedCardTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only domain cards of these types can be taken (Witchwarper: spell)."
            },
            "cardWords": {
              "type": "array",
              "description": "Word swaps printed on this class's domain cards (whole words; plurals and capitals kept).",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "domains": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/id"
                    }
                  }
                }
              }
            },
            "cardTypes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Card type relabels for this class (spell -> tech)."
            },
            "cardTypeDomains": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              },
              "description": "Domains cardTypes applies to (default all)."
            }
          }
        }
      ]
    },
    "subclass": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "$ref": "#/definitions/id"
            },
            "spellcastTrait": {
              "enum": [
                "agility",
                "strength",
                "finesse",
                "instinct",
                "presence",
                "knowledge"
              ]
            },
            "features": {
              "$ref": "#/definitions/features"
            },
            "extraDomain": {
              "$ref": "#/definitions/id",
              "description": "Domain this subclass adds, with one extra level 1 card from it at creation."
            }
          }
        }
      ]
    },
    "ancestry": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "features": {
              "$ref": "#/definitions/features"
            },
            "onlyWith": {
              "type": "string",
              "description": "Id of the campaign frame or supplement that must be selected for this ancestry to be offered."
            }
          }
        }
      ]
    },
    "community": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "features": {
              "$ref": "#/definitions/features"
            },
            "onlyWith": {
              "type": "string",
              "description": "Id of the campaign frame or supplement that must be selected for this community to be offered."
            }
          }
        }
      ]
    },
    "domain": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "classes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              }
            }
          }
        }
      ]
    },
    "domainCard": {
      "allOf": [
        {
          "$ref": "#/definitions/entry"
        },
        {
          "type": "object",
          "required": [
            "domain",
            "level"
          ],
          "properties": {
            "domain": {
              "$ref": "#/definitions/id"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "type": {
              "type": "string"
            },
            "recallCost": {
              "type": "integer",
              "minimum": 0
            },
            "rules": {
              "type": "string"
            },
            "uses": {
              "$ref": "#/definitions/count"
            },
            "trackers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/tracker"
              }
            },
            "usesPer": {
              "enum": [
                "short-rest",
                "long-rest",
                "rest",
                "scene",
                "session"
              ]
            },
            "statNote": {
              "$ref": "#/definitions/statNote"
            }
          }
